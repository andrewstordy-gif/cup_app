{
  "canonicalization_version": "cup-form-definition-jcs-v1",
  "protocol_profile": "ndef4-r1",
  "ndef_form_value": 1,
  "form_key": "sca_cva_affective_104_2024",
  "form_version": "1.0.0",
  "source": {
    "edition": "SCA Standard 104-2024, Affective Assessment",
    "sha256": "c788f986e938d3b10786ce0ee62462b21aec0ed2cfdce6de9f090e0d1b491c75",
    "sections": "5.1-5.5 and Appendix 7.2"
  },
  "fields": [
    { "id": "ratings", "type": "ordered_integer_mapping", "required_for_completion": true, "keys": ["fragrance", "aroma", "flavor", "aftertaste", "acidity", "sweetness", "mouthfeel", "overall"], "minimum": 1, "maximum": 9, "provenance": "SCA-104" },
    { "id": "affective_notes", "type": "optional_text_mapping", "required_for_completion": false, "keys": ["fragrance_aroma", "flavor_aftertaste", "acidity", "sweetness", "mouthfeel", "overall"], "provenance": "SCA-104" },
    { "id": "non_uniform_cups", "type": "assessed_cup_set", "required_for_completion": true, "provenance": "SCA-104" },
    { "id": "defective_cups", "type": "assessed_cup_set", "required_for_completion": true, "provenance": "SCA-104" },
    { "id": "defect_type", "type": "assessed_nullable_enum", "required_for_completion": true, "values": ["potato", "moldy", "phenolic"], "provenance": "SCA-104" },
    { "id": "evenly_defective_all_cups", "type": "boolean", "required_for_completion": true, "provenance": "Cup App explicit coherence evidence for SCA-104 exception" }
  ],
  "validation": [
    "response_identity_and_form_match_independently_trusted_session_pin",
    "cup_count_integer_1_to_8",
    "cup_sets_ascending_unique_one_based_within_count",
    "mandatory_absent_or_null_unassessed_except_explicit_null_defect_type",
    "one_cup_non_uniform_set_empty",
    "defect_type_null_iff_defective_set_empty",
    "even_flag_true_only_if_all_cups_defective_and_even",
    "defective_cups_subset_of_non_uniform_unless_explicit_even_all_exception",
    "no_unknown_response_fields"
  ],
  "scoring": {
    "score_formula": "21*sum(ratings)/32+211/4-10*non_uniform_count/cup_count-20*defective_count/cup_count",
    "source_five_cup_equivalent": "0.65625*sum(ratings)+52.75-2*non_uniform_count-4*defective_count",
    "rounding": "nearest_quarter_ties_up_once_final",
    "stored_unit": "integer_quarter_points",
    "display_decimals": 2,
    "no_clamp": true,
    "five_cup_label": "SCA-104 Affective score",
    "other_cup_label": "Adapted — five-cup-equivalent Cup App score",
    "other_cup_provenance": "Product Owner-approved Cup App adaptation, not specified by SCA-104"
  }
