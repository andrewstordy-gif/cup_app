{
  "expo": {
    "name": "cup",
    "slug": "cup",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/images/cup_image_transparrent.png",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5",
      "infoPlist": {
        "NFCReaderUsageDescription": "This app scans NFC cup tags to read and write cupping session data.",
        "NSCameraUsageDescription": "This app uses the camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to choose a profile photo."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "bundleIdentifier": "com.andrewstordy.cup"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/cup_image_transparrent.png",
        "backgroundColor": "#f5f5f5"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "package": "com.andrewstordy.cup"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "includeNdefEntitlement": false
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "appDisplayName": "cup",
      "eas": {
        "projectId": "a80a13f3-0ccf-4040-b71e-ed285585e160"
      }
    }
  }
}
