{
  "expo": {
    "name": "Cup User Test App",
    "slug": "cup-user-test-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "This app scans NFC cup tags to read and write cupping session data."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      },
      "bundleIdentifier": "com.andrewstordy.cupusertestapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f5"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "package": "com.andrewstordy.cupusertestapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "react-native-nfc-manager",
      "expo-sqlite"
    ]
  }
}
