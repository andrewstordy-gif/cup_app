{
  "expo": {
    "name": "Cup Mock Screens",
    "slug": "cup-mock-screens",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/cup_image.png",
    "scheme": "cup-mock-screens",
    "splash": {
      "image": "./assets/cup_image.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrewstordy.cupmockscreens"
    },
    "android": {
      "package": "com.andrewstordy.cupmockscreens",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cup_image.png",
        "backgroundColor": "#F7F4EE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "7eba6b29-b45e-4912-a096-66ada73712c7"
      }
    }
  }
}
