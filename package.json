{
  "name": "cup-user-test-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev:a": "APP_VARIANT=A expo start --dev-client",
    "start:dev:b": "APP_VARIANT=B expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:a": "APP_VARIANT=A expo run:ios --device",
    "ios:device:b": "APP_VARIANT=B expo run:ios --device",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:a": "APP_VARIANT=A expo prebuild --clean",
    "prebuild:b": "APP_VARIANT=B expo prebuild --clean"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nfc-manager": "^3.17.2"
  }
}
